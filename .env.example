# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldurun.
# .env dosyasını ASLA git'e commit etmeyin (gitignore'a ekleyin).

# Supabase Dashboard > Project Settings > API'den alın
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rastgele, uzun, kimsenin bilmediği bir değer üretin. Örnek üretim komutu:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=DEGISTIRIN-bu-cok-onemli-uzun-rastgele-bir-deger-olmali
